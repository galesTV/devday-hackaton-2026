# Necessária apenas para consultar o Portal da Transparência em tempo real.
# Solicite a chave em https://portaldatransparencia.gov.br/api-de-dados
TRANSPARENCIA_API_KEY=

# Opcional: análises explicativas sob demanda com a API oficial da OpenAI.
# Crie uma chave em https://platform.openai.com/api-keys e configure-a apenas no .env local.
OPENAI_API_KEY=
# Opcional; padrão: gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
